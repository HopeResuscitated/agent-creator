{
  "name": "@agent-creator/platform",
  "version": "0.1.0",
  "description": "Local-first autonomous AI coding agent platform with Manus-style interface",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=@agent-creator/web",
    "build": "turbo run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:all": "node scripts/verify.mjs --lint-all",
    "verify": "node scripts/verify.mjs",
    "format": "prettier --write .",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules .turbo"
  },
  "exports": {
    "./*": "./packages/cli/index.ts"
  },
  "bin": {
    "jcode": "./packages/cli/bin.js"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "eslint": "^9.34.0",
    "prettier": "^3.6.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.71.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}

{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "rewriteRelativeImportExtensions": true,
    "declaration": true,
    "outDir": "./dist",
    "rootDir": ".",
    "paths": {
      "@agent-creator/protocol": ["../protocol/types.d.ts"]
    }
  },
  "include": ["index.ts", "orchestrator.ts", "tools/**/*.ts"],
  "exclude": ["dist", "node_modules", "test"]
}
